{
  "openapi": "3.1.0",
  "info": {
    "title": "ZimbaControl API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/sync/push": {
      "post": {
        "summary": "Push local outbox operations",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation results: applied, duplicate, conflict or rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPushResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sync payload"
          }
        }
      }
    },
    "/sync/pull": {
      "get": {
        "summary": "Pull incremental sync events",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "householdId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sinceSeq",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incremental events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPullResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "summary": "Exchange a Google OpenID Connect ID token for an API session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API session for an allowed Google account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Google token"
          },
          "403": {
            "description": "Email is outside the allowlist"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "summary": "List transactions",
        "responses": {
          "200": {
            "description": "Transaction list"
          }
        }
      },
      "post": {
        "summary": "Create transaction",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/transactions/{id}": {
      "patch": {
        "summary": "Update transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/imports": {
      "post": {
        "summary": "Create import batch",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/duplicates/{id}/resolve": {
      "post": {
        "summary": "Resolve duplicate candidate",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/review/{id}/resolve": {
      "post": {
        "summary": "Resolve review item",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/rules": {
      "get": {
        "summary": "List classification rules",
        "responses": {
          "200": {
            "description": "Rule list"
          }
        }
      },
      "post": {
        "summary": "Create classification rule",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    },
    "/rules/{id}": {
      "patch": {
        "summary": "Update classification rule",
        "responses": {
          "501": {
            "description": "Planned endpoint"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GoogleAuthRequest": {
        "type": "object",
        "required": ["idToken"],
        "properties": {
          "idToken": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["token", "expiresInSeconds", "user"],
        "properties": {
          "token": { "type": "string" },
          "expiresInSeconds": { "type": "integer", "minimum": 1 },
          "user": { "$ref": "#/components/schemas/AuthUser" }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": ["sub", "email"],
        "properties": {
          "sub": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "picture": { "type": "string" }
        }
      },
      "SyncPushRequest": {
        "type": "object",
        "required": ["deviceId", "householdId", "operations"],
        "properties": {
          "deviceId": { "type": "string" },
          "householdId": { "type": "string" },
          "operations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SyncOperation" }
          }
        }
      },
      "SyncPushResponse": {
        "type": "object",
        "required": ["results", "latestSeq"],
        "properties": {
          "latestSeq": { "type": "integer", "minimum": 0 },
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SyncOperationResult" }
          }
        }
      },
      "SyncPullResponse": {
        "type": "object",
        "required": ["events", "latestSeq"],
        "properties": {
          "latestSeq": { "type": "integer", "minimum": 0 },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SyncEvent" }
          }
        }
      },
      "SyncOperation": {
        "type": "object",
        "required": [
          "opId",
          "deviceId",
          "householdId",
          "entityType",
          "entityId",
          "operationType",
          "baseVersion",
          "payload",
          "createdAt"
        ],
        "properties": {
          "opId": { "type": "string" },
          "deviceId": { "type": "string" },
          "householdId": { "type": "string" },
          "entityType": {
            "type": "string",
            "enum": ["transaction", "rule", "reviewItem", "duplicateCandidate"]
          },
          "entityId": { "type": "string" },
          "operationType": {
            "type": "string",
            "enum": ["create", "update", "delete", "resolve"]
          },
          "baseVersion": { "type": "integer", "minimum": 0 },
          "payload": { "$ref": "#/components/schemas/SyncTransactionPayload" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SyncOperationResult": {
        "type": "object",
        "required": ["opId", "result", "entityId", "seq"],
        "properties": {
          "opId": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["applied", "duplicate", "conflict", "rejected"]
          },
          "entityId": { "type": "string" },
          "seq": { "type": "integer", "minimum": 0 }
        }
      },
      "SyncTransactionPayload": {
        "type": "object",
        "description": "Versioned full transaction snapshot. Version 1 carries canonical transaction fields, beneficiaries and source records.",
        "required": ["schemaVersion", "transaction", "beneficiaries", "sources"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "transaction": { "type": "object" },
          "beneficiaries": { "type": "array", "items": { "type": "object" } },
          "sources": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      },
      "SyncEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/SyncOperation" },
          {
            "type": "object",
            "required": ["seq", "serverAt"],
            "properties": {
              "seq": { "type": "integer", "minimum": 0 },
              "serverAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      }
    }
  }
}
