{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimbacontrol.local/schemas/transaction.schema.json",
  "title": "Transaction",
  "type": "object",
  "required": [
    "id",
    "householdId",
    "kind",
    "amountCents",
    "currencyCode",
    "occurredAt",
    "competenceMonth",
    "descriptionRaw",
    "beneficiaryIds",
    "sourceRecords",
    "reviewStatus",
    "duplicateStatus",
    "baseVersion"
  ],
  "properties": {
    "id": { "type": "string" },
    "householdId": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["income", "expense", "transfer", "refund", "adjustment"]
    },
    "amountCents": { "type": "integer" },
    "currencyCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "postedAt": {
      "type": "string",
      "format": "date-time"
    },
    "competenceMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "descriptionRaw": { "type": "string" },
    "merchantId": { "type": "string" },
    "categoryId": { "type": "string" },
    "costCenterId": { "type": "string" },
    "payerId": { "type": "string" },
    "beneficiaryIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceRecords": {
      "type": "array",
      "items": {
        "$ref": "./canonical-source-record.schema.json"
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["pending", "confirmed", "ignored", "conflict"]
    },
    "duplicateStatus": {
      "type": "string",
      "enum": ["none", "probable", "duplicate", "merged"]
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
