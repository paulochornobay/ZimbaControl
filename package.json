{
  "name": "zimbacontrol",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first family finance app monorepo.",
  "workspaces": [
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "check": "npm --workspace @zimbacontrol/contracts run check && npm --workspace @zimbacontrol/api run check",
    "api:dev": "npm --workspace @zimbacontrol/api run dev",
    "api:test": "npm --workspace @zimbacontrol/api test",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "visual:capture-lovable": "node tools/capture_lovable_summary.mjs",
    "visual:capture-lovable-routes": "node tools/capture_lovable_routes.mjs",
    "visual:compare-lovable": "node tools/compare_lovable_summary.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.58.2",
    "pngjs": "^7.0.0"
  }
}
